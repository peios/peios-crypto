# AWS-LC, the implementation inside libpcrypto and libpssl: built as static
# archives of position-independent code, which the wrappers link, with every
# function renamed with the prefix `peios_awslc_`. The wrappers export only
# OpenSSL's names, so every call by them passes the wrappers' policy.
#
# Prefixing takes two builds, as AWS-LC's BUILDING.md describes. The first,
# unprefixed, gives the list of symbols, which AWS-LC's own
# `util/read_symbols.go` reads from its archives; the second renames them.
# Exported data keeps its name: a wrapper can forward a call, but not an
# address, so the data is exported as AWS-LC defines it. Both builds are
# compiled with Intel CET's landing pads and shadow-stack marking.
#
# A third build, `awslc_reference`, is AWS-LC's own shared libraries with
# its tests and `bssl` tool, which the wrappers are tested against, and
# gives the headers the wrappers ship. A fourth, `awslc_rust_bindings`,
# gives the Rust bindings they ship.
import toolchain
import Toolchain from toolchain
import GoToolchain from "github.com/gcslib/go"
import "github.com/gcslib/clang"

# AWS-LC 5.15.0, by the commit its tag names: a commit, unlike a tag or a
# generated archive, can't change.
let AWSLC_COMMIT = "4378134b6206a0a0fa62f31367d0729ca0780e4c"

let PREFIX = "peios_awslc"

# Where AWS-LC is installed, and where its builds have Go and CMake.
let AWSLC = "/opt/awslc"

let REFERENCE = "/opt/awslc-reference"

let CMAKE = cmake_path()

let GO = "/opt/go"

let SYMBOLS_OUT = "/opt/awslc-symbols"

let BINDINGS_OUT = "/opt/awslc-rust"

let BINDGEN = "/opt/bindgen"

let LIBCLANG = "/opt/libclang"

# The configuration every build shares: AWS-LC without Perl, which only
# regenerates the assembly AWS-LC ships generated, and without rewriting
# its own sources.
let CONFIGURE = "-DCMAKE_BUILD_TYPE=Release -DDISABLE_PERL=ON -DENABLE_SOURCE_MODIFICATION=OFF \
                 -DCMAKE_C_COMPILER=\"$CC\" -DCMAKE_CXX_COMPILER=\"$CXX\" \
                 -DCMAKE_AR=\"$AR\" -DCMAKE_RANLIB=\"$RANLIB\" \
                 -DCMAKE_C_FLAGS=-fcf-protection=full -DCMAKE_CXX_FLAGS=-fcf-protection=full \
                 -DCMAKE_ASM_FLAGS=-fcf-protection=full"

# The libraries alone, without AWS-LC's tests or its `bssl` tool.
let LIBRARIES = "-DBUILD_TESTING=OFF -DBUILD_TOOL=OFF"

# Go's caches in the build's own temporary directory, and nothing fetched:
# AWS-LC's Go programs use only Go's standard library.
let GO_ENV = "export PATH={GO}/bin:$PATH GOCACHE=/tmp/go-cache GOPATH=/tmp/go \
              GOFLAGS=-buildvcs=false GOTOOLCHAIN=local GOPROXY=off GOENV=off"

# Fails unless every object the build in `build` compiled carries the IBT
# and SHSTK properties.
let OBJECTS_MARKED = "[ -n \"$(find build -name '*.o' | head -1)\" ] \
                      || {{ echo 'no objects to check'; exit 1; }}; \
                      unmarked=$(find build -name '*.o' | while read -r object; do \
                      \"$READELF\" -n \"$object\" | grep -q 'IBT, SHSTK' || echo \"$object\"; done); \
                      if [ -n \"$unmarked\" ]; then echo 'objects without IBT and SHSTK:'; \
                      echo \"$unmarked\" | head -20; exit 1; fi"

def build awslc_source() {
    = fetch_git("https://github.com/aws/aws-lc.git", AWSLC_COMMIT)
}

# The symbols the second build renames, one per line: those AWS-LC's static
# libraries define, less the data they export, which AWS-LC gives default
# visibility.
def build awslc_symbols(go: GoToolchain = toolchain.get(Toolchain::Go)) {
    = installed(
        build awslc_source(),
        "{GO_ENV}; {CMAKE}/bin/cmake -S . -B build {CONFIGURE} {LIBRARIES} -DBUILD_SHARED_LIBS=OFF \
         -DDISABLE_GO=ON; {CMAKE}/bin/cmake --build build -j8; \
         go run ./util/read_symbols.go -out symbols.txt build/crypto/libcrypto.a build/ssl/libssl.a; \
         \"$READELF\" -sW build/crypto/libcrypto.a build/ssl/libssl.a \
         | awk '$4 == \"OBJECT\" && ($5 == \"GLOBAL\" || $5 == \"WEAK\") && $6 == \"DEFAULT\" \
         && $7 != \"UND\" {{ print $8 }}' | sort -u > data.txt; \
         [ -s data.txt ] || {{ echo 'AWS-LC exports no data'; exit 1; }}; mkdir -p {SYMBOLS_OUT}; \
         grep -vxF -f data.txt symbols.txt > {SYMBOLS_OUT}/symbols.txt",
        SYMBOLS_OUT,
        given = [{at = CMAKE; place = build cmake()}, {at = GO; place = go.root}],
    ).file("symbols.txt")
}

# AWS-LC's static archives and headers, every symbol `awslc_symbols` lists
# prefixed, compiled as position-independent code for the wrappers to link.
# The build fails unless every object it compiles carries the IBT and SHSTK
# properties.
def build awslc(go: GoToolchain = toolchain.get(Toolchain::Go)) {
    = installed(
        build awslc_source(),
        "{GO_ENV}; {CMAKE}/bin/cmake -S . -B build {CONFIGURE} {LIBRARIES} -DBUILD_SHARED_LIBS=OFF \
         -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DGO_EXECUTABLE={GO}/bin/go \
         -DBORINGSSL_PREFIX={PREFIX} -DBORINGSSL_PREFIX_SYMBOLS=/work/symbols.txt \
         -DCMAKE_INSTALL_PREFIX={AWSLC} -DCMAKE_INSTALL_LIBDIR=lib; \
         {CMAKE}/bin/cmake --build build -j8; {OBJECTS_MARKED}; \
         {CMAKE}/bin/cmake --install build",
        AWSLC,
        given = [
            {at = CMAKE; place = build cmake()},
            {at = GO; place = go.root},
            {at = "/work/symbols.txt"; place = build awslc_symbols()},
        ],
    )
}

# AWS-LC's shared libraries, `libcrypto-awslc.so.1` and
# `libssl-awslc.so.1`, with its `crypto_test` and `ssl_test`, and the test libraries they load, in `tests/` and
# its `bssl` and `openssl` tools in `bin/`. They're built with the prefix but an empty list
# of symbols to rename, so their C names are OpenSSL's and their C++ names,
# in `bssl::peios_awslc`, are libpssl's. Linked in place of these
# libraries, the wrappers serve the same calls, and their headers are the
# wrappers'.
def build awslc_reference(go: GoToolchain = toolchain.get(Toolchain::Go)) {
    = installed(
        build awslc_source(),
        "{GO_ENV}; : > /tmp/no-symbols.txt; {CMAKE}/bin/cmake -S . -B build {CONFIGURE} \
         -DBUILD_TESTING=ON -DBUILD_TOOL=ON -DBUILD_SHARED_LIBS=ON -DENABLE_PRE_SONAME_BUILD=OFF \
         -DGO_EXECUTABLE={GO}/bin/go -DBORINGSSL_PREFIX={PREFIX} \
         -DBORINGSSL_PREFIX_SYMBOLS=/tmp/no-symbols.txt \
         -DCMAKE_INSTALL_PREFIX={REFERENCE} -DCMAKE_INSTALL_LIBDIR=lib; \
         {CMAKE}/bin/cmake --build build -j8 --target crypto_test ssl_test bssl openssl; \
         {CMAKE}/bin/cmake --install build; mkdir -p {REFERENCE}/tests; \
         for test in crypto_test ssl_test; do \
         found=$(find build -type f -name $test); [ -n \"$found\" ] || {{ echo \"no $test\"; exit 1; }}; \
         cp $found {REFERENCE}/tests/; done; \
         find build -type f -name 'lib*.so*' ! -name 'libcrypto*' ! -name 'libssl*' \
         -exec cp {{}} {REFERENCE}/tests/ \\;",
        REFERENCE,
        given = [{at = CMAKE; place = build cmake()}, {at = GO; place = go.root}],
    )
}

# AWS-LC's Rust bindings, `aws_lc_bindings.rs`, as aws-lc-sys reads them
# from a system install: generated by AWS-LC's own build, which runs
# bindgen on its headers with the options aws-lc-sys's own bindings are
# generated with. The build is configured without the prefix, so that the
# bindings link by OpenSSL's names, the wrappers'. libclang parses with the
# C toolchain's own headers and sysroot, as its compiler would.
def build awslc_rust_bindings() {
    = installed(
        build awslc_source(),
        "export PATH={BINDGEN}:$PATH LIBCLANG_PATH={LIBCLANG}; \
         export BINDGEN_EXTRA_CLANG_ARGS=\"-isystem $($CC -print-file-name=include) \
         --sysroot=$($CC -print-sysroot)\"; \
         {CMAKE}/bin/cmake -S . -B build {CONFIGURE} {LIBRARIES} -DDISABLE_GO=ON \
         -DGENERATE_RUST_BINDINGS=ON; \
         {CMAKE}/bin/cmake --build build --target rust_bindings; \
         mkdir -p {BINDINGS_OUT}; cp build/rust/aws_lc_bindings.rs {BINDINGS_OUT}/",
        BINDINGS_OUT,
        given = [
            {at = CMAKE; place = build cmake()},
            {at = BINDGEN; place = build bindgen()},
            {at = LIBCLANG; place = clang.libclang_18()},
        ],
    ).file("aws_lc_bindings.rs")
}

def awslc_path() -> String {
    = AWSLC
}

def awslc_reference_path() -> String {
    = REFERENCE
}

def awslc_symbol_prefix() -> String {
    = PREFIX
}
