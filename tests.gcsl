# peios-crypto's tests. A test's own code runs in a hermetic step of its own,
# so what it builds, and its toolchains, are in its parameters' defaults.
import fs
import toolchain
import Toolchain from toolchain
import BuildEnv from "github.com/gcslib/buildenv"
import base from "github.com/gcslib/buildenv"
import bin_path from "github.com/gcslib/buildenv"
import "github.com/gcslib/rust"
import PythonToolchain from "github.com/gcslib/python"

let TOOL_CC = "/opt/cc"

let PCRYPTO = pcrypto_path()

let REFERENCE = awslc_reference_path()

let PREFIX = awslc_symbol_prefix()

# Where a test has the testing libraries.
let TESTING = "/opt/pcrypto-testing"

# Internals AWS-LC exports for its tests, which only the testing libraries
# export: an ML-KEM primitive, GCM's, and one of libssl's C++ internals.
let INTERNALS = "ml_kem_768_keypair CRYPTO_gcm128_encrypt _ZN4bssl11{PREFIX}9SSLBuffer5ClearEv"

# The shell commands that make the testing libraries stand in for AWS-LC's
# own shared libraries, by their names, for programs built against them,
# and fail unless `program` would load them.
fn as_awslc(program: String) -> String {
    = "mkdir -p /tmp/lib; ln -s {TESTING}/lib/libpcrypto.so.1 /tmp/lib/libcrypto-awslc.so.1; \
       ln -s {TESTING}/lib/libpssl.so.1 /tmp/lib/libssl-awslc.so.1; \
       export LD_LIBRARY_PATH=/tmp/lib:{TESTING}/lib:{REFERENCE}/tests; \
       LD_TRACE_LOADED_OBJECTS=1 {program} > /tmp/loaded || true; \
       grep -q 'libcrypto-awslc.so.1 => /tmp/lib/' /tmp/loaded \
       || {{ echo '{program} would not load the wrappers:'; cat /tmp/loaded; exit 1; }}"
}

# The wrappers keep their sonames, need no AWS-LC library, carry Intel
# CET's IBT and SHSTK properties, and export every symbol in their public
# versions, PCRYPTO_1 and PSSL_1, by a name that isn't prefixed. The one
# exception is the prefixed names libpssl calls, which libpcrypto exports
# in PEIOS_AWSLC_PRIVATE. AWS-LC's internals are exported only by the
# testing libraries, in PEIOS_AWSLC_TESTING.
def test pcrypto_exports(
    pcrypto: Dir = build pcrypto(),
    testing: Dir = build pcrypto_testing(),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
    env: BuildEnv = toolchain.get(Toolchain::BuildEnv),
) {
    let ran = checked(
        "exports() {{ \"$READELF\" --dyn-syms -W \"$1\" \
         | awk '$1 ~ /^[0-9]+:$/ && $7 != \"UND\" && $7 != \"ABS\" {{ print $8 }}'; }}; \
         for name in {INTERNALS}; do \
         if {{ exports {PCRYPTO}/lib/libpcrypto.so.1; exports {PCRYPTO}/lib/libpssl.so.1; }} \
         | grep -q \"^$name@\"; then echo \"the installed libraries export $name\"; exit 1; fi; \
         {{ exports {TESTING}/lib/libpcrypto.so.1; exports {TESTING}/lib/libpssl.so.1; }} \
         | grep -qx \"$name@@PEIOS_AWSLC_TESTING\" \
         || {{ echo \"the testing libraries don't export $name\"; exit 1; }}; done",
        [{at = PCRYPTO; place = pcrypto}, {at = TESTING; place = testing}],
        c = c,
        env = env,
    )
    let shipped = checked(
        "cd {PCRYPTO}/lib; for lib in libpcrypto libpssl; do \
         \"$READELF\" -d $lib.so.1 | grep -q \"(SONAME).*\\[$lib.so.1\\]\" \
         || {{ echo \"$lib: soname is not $lib.so.1\"; exit 1; }}; \
         if \"$READELF\" -d $lib.so.1 | grep '(NEEDED)' | grep -E 'awslc|libcrypto|libssl'; then \
         echo \"$lib needs an AWS-LC or OpenSSL library\"; exit 1; fi; \
         \"$READELF\" -n $lib.so.1 | grep -q 'IBT, SHSTK' \
         || {{ echo \"$lib lacks IBT and SHSTK\"; exit 1; }}; done; \
         exports() {{ \"$READELF\" --dyn-syms -W \"$1\" \
         | awk '$1 ~ /^[0-9]+:$/ && $7 != \"UND\" && $7 != \"ABS\" {{ print $8 }}'; }}; \
         bad=$(exports libpcrypto.so.1 | grep -v -e '^[^@]*@@PCRYPTO_1$' \
         -e '^{PREFIX}_[^@]*@@PEIOS_AWSLC_PRIVATE$' || true); \
         bad=\"$bad$(exports libpcrypto.so.1 | grep '^{PREFIX}_.*@@PCRYPTO_1$' || true)\"; \
         bad=\"$bad$(exports libpssl.so.1 | grep -v '^[^@]*@@PSSL_1$' || true)\"; \
         bad=\"$bad$(exports libpssl.so.1 | grep '^{PREFIX}_' || true)\"; \
         if [ -n \"$bad\" ]; then echo 'wrongly exported:'; echo \"$bad\" | head -20; exit 1; fi; \
         for want in SHA256@@PCRYPTO_1 X509_it@@PCRYPTO_1 SSL_CTX_new@@PSSL_1; do \
         {{ exports libpcrypto.so.1; exports libpssl.so.1; }} | grep -qx \"$want\" \
         || {{ echo \"$want is not exported\"; exit 1; }}; done",
        [{at = PCRYPTO; place = pcrypto}],
        c = c,
        env = env,
    )
}

# AWS-LC's own `crypto_test` passes against the testing libpcrypto, which
# exports the internals it calls. Two tests are left out:
#
# - `AddrFamily/BIODgramTest.SocketDatagramSetConnected/1`, of a connected
#   IPv6 datagram socket: the sandbox has no IPv6, and the test, unlike its
#   neighbours, doesn't skip itself without it.
# - `RSATest.GenerateSmallKey`, which expects AWS-LC's own error for a
#   255-bit RSA key. The key is still refused, but by Peios's policy
#   floor, before AWS-LC sees it, so the error is Peios's.
# - `EvpAeadCtxSerdeTest.ID` and the `EvpAeadCtxSerdeTest` cases for
#   `EVP_aead_null_sha1_tls`, which key the TLS NULL-cipher AEAD, on the
#   floor.
# - `CipherTest.CopyErrorPathReleasesCipherData`, which keys a cipher it
#   defines itself through AWS-LC's internal headers. The runtime refuses
#   any cipher it hasn't graded; AWS-LC's API gives programs no way to
#   define one.
# - `PKCS12Test.CreateWithAlias`, `.Order`, `.RoundTrip` and `.SetMac`,
#   and `PKCS8Test.RoundTripPBEWithSHA1And40BitRC2CBC`, which encrypt with
#   PKCS #12's RC2-40, on the floor: by name, or as `PKCS12_create`'s
#   default for certificates.
def test awslc_crypto_test(
    testing: Dir = build pcrypto_testing(),
    reference: Dir = build awslc_reference(),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
    env: BuildEnv = toolchain.get(Toolchain::BuildEnv),
) {
    let ran = checked(
        "{as_awslc("{REFERENCE}/tests/crypto_test")}; cd /tmp; {REFERENCE}/tests/crypto_test \
         --gtest_filter=-AddrFamily/BIODgramTest.SocketDatagramSetConnected/1:RSATest.GenerateSmallKey:EvpAeadCtxSerdeTest.ID:EvpAeadCtxSerdeTests/EvpAeadCtxSerdeTest.*/EVP_aead_null_sha1_tls:CipherTest.CopyErrorPathReleasesCipherData:PKCS12Test.CreateWithAlias:PKCS12Test.Order:PKCS12Test.RoundTrip:PKCS12Test.SetMac:PKCS8Test.RoundTripPBEWithSHA1And40BitRC2CBC",
        [{at = TESTING; place = testing}, {at = "{REFERENCE}/tests"; place = reference.dir("tests")}],
        c = c,
        env = env,
    )
}

# AWS-LC's own `ssl_test` passes against the testing libpssl and
# libpcrypto.
def test awslc_ssl_test(
    testing: Dir = build pcrypto_testing(),
    reference: Dir = build awslc_reference(),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
    env: BuildEnv = toolchain.get(Toolchain::BuildEnv),
) {
    let ran = checked(
        "{as_awslc("{REFERENCE}/tests/ssl_test")}; cd /tmp; {REFERENCE}/tests/ssl_test",
        [{at = TESTING; place = testing}, {at = "{REFERENCE}/tests"; place = reference.dir("tests")}],
        c = c,
        env = env,
    )
}

# AWS-LC's `bssl` tool, built against the wrappers' headers, runs against
# the testing libraries, as it calls internals too: it hashes, and
# generates and signs with a key.
def test bssl_runs(
    testing: Dir = build pcrypto_testing(),
    reference: Dir = build awslc_reference(),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
    env: BuildEnv = toolchain.get(Toolchain::BuildEnv),
) {
    let bssl = "{REFERENCE}/bin/bssl"
    let ran = checked(
        "{as_awslc(bssl)}; cd /tmp; printf abc > abc; \
         {bssl} sha256sum abc | grep -q '^ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad ' \
         || {{ echo 'bssl sha256sum gave the wrong digest'; exit 1; }}; \
         {bssl} genrsa -bits 2048 > key.pem; {bssl} sign -key key.pem -digest sha256 < abc > signature; \
         [ -s signature ] || {{ echo 'bssl sign gave no signature'; exit 1; }}",
        [{at = TESTING; place = testing}, {at = "{REFERENCE}/bin"; place = reference.dir("bin")}],
        c = c,
        env = env,
    )
}

# A program compiled against the wrappers' headers and linked with
# `-lpssl -lpcrypto`, as the wrappers' pkg-config files say, runs, with a
# copy relocation for the ASN.1 item table it uses; linked with `-lssl
# -lcrypto`, as a build that doesn't ask pkg-config links OpenSSL, it loads
# the wrappers and runs.
def test consumer_builds(
    pcrypto: Dir = build pcrypto(),
    source: File = file("tests/consumer.c"),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
    env: BuildEnv = toolchain.get(Toolchain::BuildEnv),
) {
    let ran = checked(
        "cd /tmp; \"$CC\" -fPIE -pie -fcf-protection=full -I{PCRYPTO}/include \
         -o consumer /work/consumer.c -L{PCRYPTO}/lib -lpssl -lpcrypto; \
         \"$READELF\" -rW consumer | grep -q 'R_X86_64_COPY.*ASN1_OCTET_STRING_it' \
         || {{ echo 'consumer has no copy relocation for ASN1_OCTET_STRING_it'; exit 1; }}; \
         LD_LIBRARY_PATH={PCRYPTO}/lib ./consumer; \
         \"$CC\" -fPIE -pie -fcf-protection=full -I{PCRYPTO}/include \
         -o consumer-openssl-names /work/consumer.c -L{PCRYPTO}/lib -lssl -lcrypto; \
         for lib in libpssl.so.1 libpcrypto.so.1; do \
         \"$READELF\" -d consumer-openssl-names | grep -q \"(NEEDED).*\\[$lib\\]\" \
         || {{ echo \"linked with -lssl -lcrypto, the consumer does not load $lib\"; exit 1; }}; done; \
         LD_LIBRARY_PATH={PCRYPTO}/lib ./consumer-openssl-names",
        [{at = PCRYPTO; place = pcrypto}, {at = "/work/consumer.c"; place = source}],
        c = c,
        env = env,
    )
}

# The generator refuses bindings that miss a public function, name one
# AWS-LC doesn't export, classify one twice or give a group no reason, and
# algorithms that leave a digest ungraded.
def test generator_refuses(
    inputs: Dir = build generator_inputs(),
    generator: File = file("generate.py"),
    test: File = file("tests/generator_test.py"),
    bindings: File = file("bindings.toml"),
    algorithms: File = file("algorithms.toml"),
    python: PythonToolchain = toolchain.get(Toolchain::Python),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
    env: BuildEnv = toolchain.get(Toolchain::BuildEnv),
) {
    let ran = checked(
        "/opt/python/bin/python3 -I /work/generator_test.py /work/generate.py /work/inputs \
         /work/bindings.toml /work/algorithms.toml {PREFIX}",
        [
            {at = "/work/inputs"; place = inputs},
            {at = "/work/generate.py"; place = generator},
            {at = "/work/generator_test.py"; place = test},
            {at = "/work/bindings.toml"; place = bindings},
            {at = "/work/algorithms.toml"; place = algorithms},
            {at = "/opt/python"; place = python.root},
        ],
        c = c,
        env = env,
    )
}

# libpcrypto's policy hooks refuse the floor, refuse what isn't graded, and
# allow the rest under Peios's default policy; every digest and cipher
# AWS-LC offers is graded.
def test policy_hooks(
    pcrypto: Dir = build pcrypto(),
    source: File = file("tests/policy_hooks.c"),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
    env: BuildEnv = toolchain.get(Toolchain::BuildEnv),
) {
    let ran = checked(
        "cd /tmp; \"$CC\" -Wall -Werror -I{PCRYPTO}/include -o policy_hooks /work/policy_hooks.c \
         -L{PCRYPTO}/lib -lpcrypto; LD_LIBRARY_PATH={PCRYPTO}/lib ./policy_hooks",
        [{at = PCRYPTO; place = pcrypto}, {at = "/work/policy_hooks.c"; place = source}],
        c = c,
        env = env,
    )
}

# The policy decision, under policies the libraries don't run with yet:
# tightened grades and FIPS.
def test policy_decision(
    runtime: Dir = dir("runtime"),
    source: File = file("tests/decision_test.c"),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
    env: BuildEnv = toolchain.get(Toolchain::BuildEnv),
) {
    let ran = checked(
        "cd /tmp; \"$CC\" -Wall -Wextra -Werror -I/work/runtime -o decision_test \
         /work/decision_test.c /work/runtime/decision.c; ./decision_test",
        [{at = "/work/runtime"; place = runtime}, {at = "/work/decision_test.c"; place = source}],
        c = c,
        env = env,
    )
}

# The aws-lc-rs program in `tests/rust`, built with aws-lc-sys in system
# mode, given the wrappers' tree as the system's AWS-LC: their headers,
# their Rust bindings, and `libcrypto.so`, which aws-lc-sys looks for.
def build system_awslc() {
    let ws = rust.workspace(
        dir("tests/rust"),
        rust.vendored(file("tests/rust/Cargo.lock")),
        crates = [
            {
                package = "aws-lc-sys"
                env = [{key = "AWS_LC_SYS_SYSTEM_DIR"; value = PCRYPTO}]
                given = [{at = PCRYPTO; place = build pcrypto()}]
            },
        ],
    )
    = rust.bin(ws, "system-awslc")
}

# The aws-lc-rs program runs against libpcrypto: it loads it by its soname
# and carries no AWS-LC of its own, which aws-lc-sys would have built with
# its own prefix.
def test aws_lc_rs_system(
    program: File = build system_awslc(),
    pcrypto: Dir = build pcrypto(),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
    env: BuildEnv = toolchain.get(Toolchain::BuildEnv),
) {
    let ran = checked(
        "\"$READELF\" -d /work/system-awslc | grep -q '(NEEDED).*\\[libpcrypto.so.1\\]' \
         || {{ echo 'the program does not load libpcrypto.so.1'; exit 1; }}; \
         if \"$NM\" /work/system-awslc 2>/dev/null | grep -q 'aws_lc_0_'; then \
         echo 'the program carries its own AWS-LC'; exit 1; fi; \
         LD_LIBRARY_PATH={PCRYPTO}/lib /work/system-awslc | grep -qx 'system-awslc: ok'",
        [{at = PCRYPTO; place = pcrypto}, {at = "/work/system-awslc"; place = program}],
        c = c,
        env = env,
    )
}

# Runs `script` with the C toolchain's compiler and tools, as `installed`
# gives them, and `given` placed.
#[hermetic]
fn checked(
    script: String,
    given: List<{at: String, place: Dir | File}>,
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
    env: BuildEnv = toolchain.get(Toolchain::BuildEnv),
) -> {} {
    let at = fn(tool: File) -> String { "{TOOL_CC}/{tool.path.strip_prefix(c.root.path).strip_prefix("/")}" }
    let binutils = at(c.ar).strip_suffix("ar")
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        ...base(env, c.runtime),
        {at = TOOL_CC; place = c.root},
        ...(for each in given { = {at = each.at; place = each.place} }),
    ]
    let box = fs.compose(placed).sandbox(
        cwd = "/",
        env = {
            CC = at(c.cc)
            NM = "{binutils}nm"
            READELF = "{binutils}readelf"
            PATH = bin_path(c.runtime)
            HOME = "/tmp"
        },
    )
    let ran = box.exec("/bin/sh", "-c", "set -e; mkdir -p /tmp; {script}")
    = {}
}
