# libpcrypto and libpssl, the OpenSSL-compatible libraries Peios provides:
# AWS-LC's prefixed archives, linked with forwarders that export each of
# their public functions by its OpenSSL name, and AWS-LC's headers with its
# pkg-config names, `libcrypto`, `libssl` and `openssl`. The forwarders and
# version scripts are generated from the archives' own symbol tables by
# `generate.py`, so every function AWS-LC's API has is
# forwarded, and the build fails on any symbol it can't classify.
#
# `libcrypto.so` and `libssl.so` link to the wrappers, so that a build
# that links `-lcrypto -lssl` without asking pkg-config links them, and so
# that aws-lc-sys, which looks for AWS-LC by those names, finds them. It
# reads the Rust bindings at `share/rust/aws_lc_bindings.rs`.
#
# The tree is laid out to install under `/usr`, as its pkg-config files
# say. Each library is linked without glibc's `crti.o` and `crtn.o`, whose
# Bootlin builds lack the IBT and SHSTK properties: shared libraries need
# neither, as the C runtime calls their constructors from `.init_array`.
# Each is linked to fail unless every object in it carries the
# properties.
import toolchain
import Toolchain from toolchain
import PythonToolchain from "github.com/gcslib/python"
import build * from "github.com/peios/peios-sdk"

let PCRYPTO = "/opt/pcrypto"

let WRAPPERS = "/opt/wrappers"

let REFERENCE = awslc_reference_path()

let GENERATOR = "/work/generate.py"

let BINDINGS_TOML = "/work/bindings.toml"

let ALGORITHMS_TOML = "/work/algorithms.toml"

let RUNTIME = "/work/runtime"

let PYTHON = "/opt/python"

let BINDINGS = "/work/aws_lc_bindings.rs"

# libpeios, which libpcrypto links: the policy runtime reads its process's
# token and checks exceptions' ProgramSecurity through it.
let PEIOS = "/opt/peios"

# AWS-LC's source, whose internal headers declare the functions outside its
# API that the runtime wraps, so that a changed declaration fails the build.
let AWSLC_SOURCE = "/opt/awslc-source"

# How the generated hooks and the policy runtime are compiled, with debug
# information named as AWS-LC's is (awslc.gcsl).
let OWN_CFLAGS = "-O2 -g -ffile-prefix-map=/work/=/usr/src/debug/peios-crypto/ -fPIC \
                  -fcf-protection=full -Wall -Wextra -Werror"

# The link both libraries share. Each binds its own calls to its own
# functions, so that a program can't take over AWS-LC's internal calls by
# defining a prefixed name libpcrypto exports. Data isn't bound: a program's
# copy of an exported table is the one every library uses. Each has a build
# ID, by which a debug package's symbols are found, whatever the compiler's
# default.
let LINK = "-shared -nostartfiles -Wl,-z,relro,-z,now,-z,noexecstack,-z,cet-report=error \
            -Wl,--no-undefined -Wl,-Bsymbolic-functions -Wl,--build-id=sha1"

# The version AWS-LC's own pkg-config files give: the OpenSSL API it
# provides.
let OPENSSL_API = "1.1.1"

# The tree Peios installs.
def build pcrypto() {
    = build wrappers().dir("dist")
}

# The testing libraries: the same libraries, exporting too the internals
# AWS-LC exports for its own tests to call, which its tests and `bssl` are
# run against. They are never installed.
def build pcrypto_testing() {
    = build wrappers().dir("testing")
}

# What the generator read, for the tests that check it refuses what it
# should: the public headers, preprocessed, and the archives' symbols.
def build generator_inputs() {
    = build wrappers().dir("inputs")
}

# The installed tree in `dist`, and the testing libraries in `testing/lib`,
# linked from the same objects, and the generator's inputs in `inputs`. The identifiers AWS-LC's public headers
# declare, which say which of its exports are public, are those the headers
# give C and C++ programs, preprocessed, and those in the macros the headers
# define for programs to expand.
def build wrappers(python: PythonToolchain = toolchain.get(Toolchain::Python)) {
    = installed(
        build awslc(),
        "D={WRAPPERS}/dist; T={WRAPPERS}/testing; I={WRAPPERS}/inputs; \
         mkdir -p gen $D/lib/pkgconfig $D/include $D/share/rust $T/lib $I; \
         find {REFERENCE}/include/openssl -name '*.h' \
         | grep -v -E '/(arm_arch|asm_base|boringssl_prefix_symbols|boringssl_prefix_symbols_asm)\\.h$' \
         | sed 's|^{REFERENCE}/include/||' | sort | sed 's|.*|#include <&>|' > gen/public.c; \
         $CC -E -dD -I{REFERENCE}/include gen/public.c > gen/public.i; \
         $CXX -E -dD -x c++ -I{REFERENCE}/include gen/public.c > gen/public.ii; \
         cat gen/public.i gen/public.ii > gen/public.pre; \
         \"$READELF\" -sW lib/libcrypto.a > gen/crypto.syms; \
         \"$READELF\" -sW lib/libssl.a > gen/ssl.syms; \
         {PYTHON}/bin/python3 -I {GENERATOR} {awslc_symbol_prefix()} gen/public.pre \
         gen/crypto.syms gen/ssl.syms {BINDINGS_TOML} {ALGORITHMS_TOML} gen; \
         cp gen/public.pre gen/crypto.syms gen/ssl.syms $I/; \
         for lib in crypto ssl; do \
         $CC -c gen/$lib-forwarders.S -o gen/$lib-forwarders.o; \
         $CC {OWN_CFLAGS} -I{REFERENCE}/include -I{RUNTIME} -c gen/$lib-hooks.c -o gen/$lib-hooks.o; \
         done; \
         $CC {OWN_CFLAGS} -Iinclude -I{RUNTIME} -Igen -c {RUNTIME}/policy.c -o gen/policy.o; \
         $CC {OWN_CFLAGS} -DPEIOS_TESTING -Iinclude -I{RUNTIME} -Igen -c {RUNTIME}/policy.c \
         -o gen/policy-testing.o; \
         $CC {OWN_CFLAGS} -Iinclude -I{PEIOS}/include -I{RUNTIME} -c {RUNTIME}/machine.c \
         -o gen/machine.o; \
         $CC {OWN_CFLAGS} -DPEIOS_TESTING -Iinclude -I{PEIOS}/include -I{RUNTIME} \
         -c {RUNTIME}/machine.c -o gen/machine-testing.o; \
         $CC {OWN_CFLAGS} -I{RUNTIME} -c {RUNTIME}/decision.c -o gen/decision.o; \
         $CC {OWN_CFLAGS} -Iinclude -I{RUNTIME} -c gen/policy-table.c -o gen/policy-table.o; \
         $CC {OWN_CFLAGS} -I{REFERENCE}/include -I{RUNTIME} -Igen -c {RUNTIME}/tls.c -o gen/tls.o; \
         $CC {OWN_CFLAGS} -Iinclude -I{RUNTIME} -Igen -I{AWSLC_SOURCE} -c {RUNTIME}/reading.c \
         -o gen/reading.o; \
         begin=$($CC -print-file-name=crtbeginS.o); end=$($CC -print-file-name=crtendS.o); \
         for variant in dist testing; do \
         if [ $variant = dist ]; then maps=; out=$D/lib; else maps=-testing; out=$T/lib; fi; \
         if [ $variant = dist ]; then policy=\"gen/policy.o gen/machine.o\"; \
         else policy=\"gen/policy-testing.o gen/machine-testing.o\"; fi; \
         $CC {LINK} -Wl,-soname,libpcrypto.so.1 -o $out/libpcrypto.so.1 \"$begin\" \
         gen/crypto-forwarders.o gen/crypto-hooks.o $policy gen/decision.o gen/policy-table.o \
         gen/reading.o @gen/crypto-wraps.rsp -Wl,--whole-archive lib/libcrypto.a -Wl,--no-whole-archive \
         -Wl,--version-script=gen/crypto$maps.map -L{PEIOS}/lib -lpeios -lpthread \"$end\"; \
         $CXX {LINK} -Wl,-soname,libpssl.so.1 -o $out/libpssl.so.1 \"$begin\" \
         gen/ssl-forwarders.o gen/ssl-hooks.o gen/tls.o @gen/ssl-wraps.rsp \
         -Wl,--whole-archive lib/libssl.a -Wl,--no-whole-archive \
         -Wl,--version-script=gen/ssl$maps.map -L$out -l:libpcrypto.so.1 -lpthread \"$end\"; \
         done; \
         ln -s libpcrypto.so.1 $D/lib/libpcrypto.so; ln -s libpssl.so.1 $D/lib/libpssl.so; \
         ln -s libpcrypto.so.1 $D/lib/libcrypto.so; ln -s libpssl.so.1 $D/lib/libssl.so; \
         cp -R {REFERENCE}/include/openssl $D/include/; \
         cp {BINDINGS} $D/share/rust/aws_lc_bindings.rs; \
         mkdir -p $D/share/peios-crypto; cp gen/algorithms.tsv $D/share/peios-crypto/algorithms.tsv; \
         {pc("libcrypto", "The Peios OpenSSL-compatible cryptography library", "", "-lpcrypto", "-lpeios")}; \
         {pc("libssl", "The Peios OpenSSL-compatible TLS library", "Requires.private: libcrypto", "-lpssl")}; \
         {pc("openssl", "The Peios OpenSSL-compatible libraries", "Requires: libssl libcrypto", "")}",
        WRAPPERS,
        given = [
            {at = REFERENCE; place = build awslc_reference()},
            {at = GENERATOR; place = file("generate.py")},
            {at = BINDINGS_TOML; place = file("bindings.toml")},
            {at = ALGORITHMS_TOML; place = file("algorithms.toml")},
            {at = RUNTIME; place = dir("runtime")},
            {at = PYTHON; place = python.root},
            {at = BINDINGS; place = build awslc_rust_bindings()},
            {at = AWSLC_SOURCE; place = build awslc_source()},
            {at = "{PEIOS}/lib/libpeios.so"; place = build libpeios()},
            {at = "{PEIOS}/include"; place = build libpeios_include()},
        ],
    )
}

# The shell command that writes the pkg-config file `name`.pc, one line for
# each of printf's arguments, into the installed tree at `$D`.
fn pc(name: String, description: String, requires: String, libs: String, private: String = "") -> String {
    let requires_line = if requires == "" { "" } else { "'{requires}'" }
    let libs_line = if libs == "" { "" } else { "'Libs: -L${{libdir}} {libs}'" }
    let private_line = if private == "" { "" } else { "'Libs.private: {private}'" }
    = "printf '%s\\n' 'prefix=/usr' 'libdir=${{prefix}}/lib' 'includedir=${{prefix}}/include' '' \
       'Name: {name}' 'Description: {description}' 'Version: {OPENSSL_API}' \
       {requires_line} {libs_line} {private_line} 'Cflags: -I${{includedir}}' > $D/lib/pkgconfig/{name}.pc"
}

# Where a program that loads libpcrypto finds libpeios, which it needs.
def peios_path() -> String {
    = PEIOS
}

# What a program that links or loads libpcrypto needs beside it: libpeios,
# by its soname, under peios_path(). A cross linker finds it there with
# `-Wl,-rpath-link,{peios_path()}/lib`.
def pcrypto_needs() -> List<{at: String, place: Dir | File}> {
    = [{at = "{PEIOS}/lib/libpeios.so.0"; place = build libpeios()}]
}

def pcrypto_path() -> String {
    = PCRYPTO
}
